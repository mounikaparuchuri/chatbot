{
  "name": "Backup n8n Workflows to GitHub (Delta)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 0
            }
          ]
        }
      },
      "id": "b2c3d4e5-0001-0001-0001-000000000001",
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-n8n-base-url",
              "name": "n8nApiBaseUrl",
              "value": "https://YOUR-N8N-INSTANCE.example.com",
              "type": "string"
            },
            {
              "id": "cfg-github-owner",
              "name": "githubOwner",
              "value": "mounikaparuchuri",
              "type": "string"
            },
            {
              "id": "cfg-github-repo",
              "name": "githubRepo",
              "value": "chatbot",
              "type": "string"
            },
            {
              "id": "cfg-github-branch",
              "name": "githubBranch",
              "value": "main",
              "type": "string"
            },
            {
              "id": "cfg-backup-base-path",
              "name": "backupBasePath",
              "value": "backups",
              "type": "string"
            },
            {
              "id": "cfg-manifest-path",
              "name": "manifestPath",
              "value": "backups/manifest.json",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 400]
    },
    {
      "parameters": {
        "url": "={{ $json.n8nApiBaseUrl }}/api/v1/workflows?limit=250",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2c3d4e5-0003-0003-0003-000000000003",
      "name": "List n8n Workflows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_N8N_API_HEADER_CREDENTIAL_ID",
          "name": "n8n API Key (X-N8N-API-KEY)"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.githubOwner }}/{{ $('Config').first().json.githubRepo }}/contents/{{ $('Config').first().json.manifestPath }}?ref={{ $('Config').first().json.githubBranch }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "id": "b2c3d4e5-0004-0004-0004-000000000004",
      "name": "Get Manifest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 400],
      "continueOnFail": true,
      "credentials": {
        "githubApi": {
          "id": "YOUR_GITHUB_CREDENTIAL_ID",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Compare each n8n workflow's updatedAt against the manifest committed\n// last run. Anything new or changed goes into this run's delta folder;\n// unchanged workflows are skipped entirely (no folder created for them).\nconst workflowsResp = $('List n8n Workflows').first().json;\nconst workflows = workflowsResp.data || workflowsResp;\n\nconst manifestResp = $('Get Manifest').first();\nlet manifest = {};\nlet manifestSha = null;\nif (manifestResp && manifestResp.json && manifestResp.json.content) {\n  try {\n    manifest = JSON.parse(Buffer.from(manifestResp.json.content, 'base64').toString('utf8'));\n    manifestSha = manifestResp.json.sha;\n  } catch (e) {\n    manifest = {};\n  }\n}\n\nconst config = $('Config').first().json;\nconst runDate = new Date().toISOString().slice(0, 10);\n\nfunction slugify(name) {\n  return String(name)\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/(^-|-$)/g, '');\n}\n\nconst changed = [];\nfor (const wf of workflows) {\n  const prev = manifest[wf.id];\n  if (!prev || prev.updatedAt !== wf.updatedAt) {\n    const path = `${config.backupBasePath}/${runDate}/${slugify(wf.name)}-${wf.id}.json`;\n    changed.push({\n      id: wf.id,\n      name: wf.name,\n      updatedAt: wf.updatedAt,\n      path,\n      content: JSON.stringify(wf, null, 2)\n    });\n    manifest[wf.id] = { name: wf.name, updatedAt: wf.updatedAt, path };\n  }\n}\n\nreturn [{\n  json: {\n    changed,\n    hasChanges: changed.length > 0,\n    runDate,\n    newManifest: manifest,\n    manifestSha\n  }\n}];"
      },
      "id": "b2c3d4e5-0005-0005-0005-000000000005",
      "name": "Compute Deltas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-changes",
              "leftValue": "={{ $json.hasChanges }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2c3d4e5-0006-0006-0006-000000000006",
      "name": "Has Changes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "fieldToSplitOut": "changed",
        "options": {}
      },
      "id": "b2c3d4e5-0007-0007-0007-000000000007",
      "name": "Split Out Changed Workflows",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1560, 280]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "create",
        "owner": "={{ $('Config').first().json.githubOwner }}",
        "repository": "={{ $('Config').first().json.githubRepo }}",
        "filePath": "={{ $json.path }}",
        "fileContent": "={{ $json.content }}",
        "commitMessage": "=Backup: {{ $json.name }} ({{ $json.id }})",
        "additionalParameters": {
          "branch": {
            "branch": "={{ $('Config').first().json.githubBranch }}"
          }
        }
      },
      "id": "b2c3d4e5-0008-0008-0008-000000000008",
      "name": "Commit Workflow Backup",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1780, 280],
      "credentials": {
        "githubApi": {
          "id": "YOUR_GITHUB_CREDENTIAL_ID",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.githubOwner }}/{{ $('Config').first().json.githubRepo }}/contents/{{ $('Config').first().json.manifestPath }}",
        "method": "PUT",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ Object.assign(\n  {\n    message: `Update manifest - backup ${$json.runDate}`,\n    content: Buffer.from(JSON.stringify($json.newManifest, null, 2)).toString('base64'),\n    branch: $('Config').first().json.githubBranch\n  },\n  $json.manifestSha ? { sha: $json.manifestSha } : {}\n) }}",
        "options": {}
      },
      "id": "b2c3d4e5-0009-0009-0009-000000000009",
      "name": "Update Manifest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 480],
      "credentials": {
        "githubApi": {
          "id": "YOUR_GITHUB_CREDENTIAL_ID",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {},
      "id": "b2c3d4e5-0010-0010-0010-000000000010",
      "name": "No Changes",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1560, 620]
    }
  ],
  "connections": {
    "Daily Trigger": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "List n8n Workflows", "type": "main", "index": 0 }]]
    },
    "List n8n Workflows": {
      "main": [[{ "node": "Get Manifest", "type": "main", "index": 0 }]]
    },
    "Get Manifest": {
      "main": [[{ "node": "Compute Deltas", "type": "main", "index": 0 }]]
    },
    "Compute Deltas": {
      "main": [[{ "node": "Has Changes?", "type": "main", "index": 0 }]]
    },
    "Has Changes?": {
      "main": [
        [
          { "node": "Split Out Changed Workflows", "type": "main", "index": 0 },
          { "node": "Update Manifest", "type": "main", "index": 0 }
        ],
        [
          { "node": "No Changes", "type": "main", "index": 0 }
        ]
      ]
    },
    "Split Out Changed Workflows": {
      "main": [[{ "node": "Commit Workflow Backup", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-08-18T00:00:00.000Z",
  "versionId": "1"
}